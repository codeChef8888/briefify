# Virtual environment
.venv/
venv/
env/

# Python bytecode cache — compiled output, never commit
__pycache__/
*.py[cod]
*.pyo

# Editable install metadata — auto-generated by `pip install -e .`
*.egg-info/
*.egg
src/briefify.egg-info/

# Distribution / build outputs
dist/
build/
*.whl

# Pytest cache
.pytest_cache/
.coverage
htmlcov/

# Type/lint caches
.mypy_cache/
.ruff_cache/

# Environment variables
.env

# Agent Briefify Output
output/
.agents
.claude

# Streamlit cache and local settings
.streamlit/

# OS/editor artifacts
.DS_Store
.idea/
.vscode/

# Keep CI/CD workflows tracked in source control.
.github