# Briefify environment configuration template
# Copy this file to .env and fill in values.
# Do NOT commit real credentials to source control.

# ==============================
# Required: Data source settings
# ==============================
# Google Cloud project ID that hosts the telemetry table
GCP_PROJECT_ID=your-gcp-project-id

# BigQuery dataset containing account telemetry snapshots
DATASET_ID=crm_telemetry

# BigQuery table name inside DATASET_ID
TABLE_ID=account_usage

# ==============================
# Required: Model access
# ==============================
# Gemini API key used by Google ADK / google-genai
GEMINI_API_KEY=your-gemini-api-key

# ==============================
# Optional: Agent/model runtime
# ==============================
# Strategist model name
ADK_MODEL=gemini-3.5-flash

# Adds a small delay before workflow start to smooth webhook bursts (seconds)
WORKFLOW_RATE_DELAY_SEC=0

# Max retries when model output fails strict SalesBriefSchema validation
WORKFLOW_MAX_SCHEMA_RETRIES=2

# Base delay in seconds between schema-invalid retries
WORKFLOW_SCHEMA_RETRY_DELAY_SEC=0.5

# Enable verbose workflow node I/O tracing (0/1)
WORKFLOW_DEBUG_NODE_IO=0

# Enable raw event usage_metadata tracing (0/1)
WORKFLOW_DEBUG_USAGE_METADATA=0

# Max chars to print per node input/output trace payload
WORKFLOW_DEBUG_NODE_IO_MAX_CHARS=5000

# ==================================
# Optional: Telemetry node hardening
# ==================================
# Max accepted size for node input payload (bytes)
TELEMETRY_NODE_MAX_INPUT_BYTES=8192

# Retry count for transient BigQuery failures
BQ_MAX_RETRIES=2

# Exponential backoff base delay for BigQuery retries (seconds)
BQ_RETRY_BASE_DELAY_SEC=0.5

# BigQuery result timeout (seconds)
BQ_QUERY_TIMEOUT_SEC=15

# Lookback horizon for telemetry snapshots and query limit
TELEMETRY_LOOKBACK_MONTHS=12

# Require month-over-month contiguous snapshots before feature engineering
TELEMETRY_REQUIRE_CONTIGUOUS_MONTHS=1

# Use partition-pruned date boundary parameter for snapshot_month filtering
TELEMETRY_ENABLE_PARTITION_PRUNING=1

# Runtime environment (prod|production|staging|dev etc.)
APP_ENV=dev

# In non-prod, run BigQuery dry-run and block expensive queries above byte threshold
BQ_ENABLE_DRY_RUN_GUARD=0
BQ_DRY_RUN_MAX_BYTES=1000000000

# ==================================
# Optional: Ledger/cost telemetry
# ==================================
# Directory where execution ledger JSONL is written
BRIEFIFY_LOG_DIR=output/logs

# Model metadata for ledger entries
BRIEFIFY_LLM_MODEL=gemini-3.5-flash
BRIEFIFY_PRICING_VERSION=gemini_flash_default_v1

# Token cost assumptions (USD per 1M tokens)
BRIEFIFY_INPUT_COST_PER_MILLION=0.075
BRIEFIFY_OUTPUT_COST_PER_MILLION=0.30

# ==============================
# Optional: API hardening
# ==============================
# Max POST body size for /webhook/crm-event (bytes)
MAX_WEBHOOK_PAYLOAD_BYTES=16384

# ==================================
# Optional: Google auth alternatives
# ==================================
# If not using gcloud ADC, provide service account JSON path
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
